# Local development: copy to .env. Production values live in .env.production.
# Use the project URL and the *publishable* key (Settings > API Keys); never the secret key.
# Both are safe in a browser app; access is controlled by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AdSense (optional). ca-pub-... publisher ID and numeric ad-unit IDs.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_RESULT=
